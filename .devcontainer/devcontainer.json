{
  "name": "Python Data Science (uv + Jupyter)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {}
  },
  "containerEnv": {
    "UV_LINK_MODE": "copy",
    "UV_PROJECT_ENVIRONMENT": "${containerWorkspaceFolder}/.venv"
  },
  "forwardPorts": [8888],
  "postCreateCommand": "uv venv --allow-existing && uv pip install --no-cache pandas numpy jupyterlab notebook && bash .devcontainer/start-jupyter.sh",
  "postStartCommand": "bash .devcontainer/start-jupyter.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff"
      ]
    }
  },
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab Server",
      "onAutoForward": "openPreview"
    }
  }
}
